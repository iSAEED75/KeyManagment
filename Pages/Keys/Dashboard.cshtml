@page
@model KeyManagment.Pages.Keys.DashboardModel
@{
    ViewData["Title"] = "داشبورد مدیر";
}

<h2>داشبورد مدیریت کلید</h2>

<!-- آمار کلی -->
<div style="display:grid; grid-template-columns:repeat(4,1fr); gap:15px; margin-bottom:30px;">
    <div style="background:#0d6efd; color:white; padding:20px; border-radius:8px; text-align:center;">
        <h3>@Model.TotalKeys</h3>
        <p>کل کلیدها</p>
    </div>
    <div style="background:#198754; color:white; padding:20px; border-radius:8px; text-align:center;">
        <h3>@Model.AvailableKeys</h3>
        <p>موجود</p>
    </div>
    <div style="background:#fd7e14; color:white; padding:20px; border-radius:8px; text-align:center;">
        <h3>@Model.CheckedOutKeys</h3>
        <p>خارج‌شده</p>
    </div>
    <div style="background:#dc3545; color:white; padding:20px; border-radius:8px; text-align:center;">
        <h3>@Model.ExpiredKeys</h3>
        <p>⚠ منقضی شده</p>
    </div>
</div>

<!-- کلیدهای منقضی شده -->
@if (Model.ExpiredHandovers.Any())
{
    <div style="border: 2px solid #dc3545; border-radius:8px; margin-bottom:30px; overflow:hidden;">
        <div style="background:#dc3545; color:white; padding:12px 20px;">
            <h5 style="margin:0;">⚠ کلیدهای منقضی شده (@Model.ExpiredHandovers.Count عدد)</h5>
            <small>این کلیدها از مهلت مقرر گذشته‌اند و باید بازگردانده شوند</small>
        </div>
        <table class="table table-bordered mb-0">
            <thead class="table-danger">
                <tr>
                    <th>کد کلید</th>
                    <th>اتاق</th>
                    <th>تحویل گیرنده</th>
                    <th>واحد</th>
                    <th>تحویل‌دهنده</th>
                    <th>زمان تحویل</th>
                    <th>مهلت بازگشت</th>
                    <th> تأخیر</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in Model.ExpiredHandovers)
                {
                    var delay = DateTime.Now - h.ExpiryTime!.Value;
                    <tr class="table-danger">
                        <td><strong>@h.Key.KeyCode</strong></td>
                        <td>@h.Key.RoomName — @h.Key.Building.Name</td>
                        <td>@h.ReceiverName</td>
                        <td>@h.ReceiverDepartment</td>
                        <td>@h.GuardName</td>
                        <td>@h.CheckoutTime.ToString("HH:mm — yyyy/MM/dd")</td>
                        <td>@h.ExpiryTime?.ToString("HH:mm — yyyy/MM/dd")</td>
                        <td>
                            <span class="badge bg-danger">
                                ساعت@((int)delay.TotalHours) و دقیقه تأخیر @delay.Minutes
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- کلیدهای فعال (منقضی نشده) -->
<h5>کلیدهای فعلاً خارج‌شده (@Model.ActiveHandovers.Count عدد)</h5>
@if (!Model.ActiveHandovers.Any())
{
    <div class="alert alert-info">هیچ کلید فعالی خارج نشده.</div>
}
else
{
    <table class="table table-bordered mb-4">
        <thead class="table-warning">
            <tr>
                <th>کد کلید</th>
                <th>اتاق</th>
                <th>تحویل گیرنده</th>
                <th>واحد</th>
                <th>تحویل‌دهنده</th>
                <th>زمان تحویل</th>
                <th>مهلت تا</th>
                <th>زمان باقیمانده</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var h in Model.ActiveHandovers)
            {
                <tr>
                    <td><strong>@h.Key.KeyCode</strong></td>
                    <td>@h.Key.RoomName — @h.Key.Building.Name</td>
                    <td>@h.ReceiverName</td>
                    <td>@h.ReceiverDepartment</td>
                    <td>@h.GuardName</td>
                    <td>@h.CheckoutTime.ToShamsiWithTime()</td>
                    <td>@h.ExpiryTime.ToShamsiWithTime()</td>
                    <td>
                        <span class="timer badge bg-warning text-dark"
                              data-expiry="@(((DateTimeOffset)h.ExpiryTime!.Value).ToUnixTimeMilliseconds())">
                            در حال محاسبه...
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- تاریخچه اخیر -->

