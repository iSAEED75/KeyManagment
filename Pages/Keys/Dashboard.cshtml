@page
@model KeyManagment.Pages.Keys.DashboardModel
@{
    ViewData["Title"] = "داشبورد مدیر";
}

<style>
    /* ---------- ردیف عنوان ---------- */
    .dash-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 16px;
    }

    /* ---------- کارت‌های آماری: همیشه یک ردیف افقی ---------- */
    .stats-row {
        display: flex;
        flex-direction: row;
        flex-wrap: nowrap;
        gap: 14px;
        margin-bottom: 26px;
        overflow-x: auto;
    }

    .stat-card {
        flex: 1 1 0;
        min-width: 150px;
        position: relative;
        overflow: hidden;
        border-radius: 14px;
        padding: 20px 18px;
        color: #fff;
        box-shadow: 0 6px 18px rgba(0,0,0,0.12);
        opacity: 0;
        transform: translateY(14px);
        animation: statIn 0.45s ease forwards;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .stat-card:nth-child(1) { animation-delay: .05s; background: linear-gradient(135deg,#0d6efd,#0a58ca); }
    .stat-card:nth-child(2) { animation-delay: .12s; background: linear-gradient(135deg,#20c997,#198754); }
    .stat-card:nth-child(3) { animation-delay: .19s; background: linear-gradient(135deg,#fd9843,#fd7e14); }
    .stat-card:nth-child(4) { animation-delay: .26s; background: linear-gradient(135deg,#ff6b6b,#dc3545); }

    @@keyframes statIn {
        to { opacity: 1; transform: translateY(0); }
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 24px rgba(0,0,0,0.2);
    }

    .stat-card .stat-icon {
        position: absolute;
        left: 14px;
        top: 14px;
        font-size: 1.6rem;
        opacity: .35;
    }

    .stat-card .stat-value {
        font-size: 1.9rem;
        font-weight: 800;
        margin: 0;
    }

    .stat-card .stat-label {
        margin: 4px 0 0;
        opacity: .92;
        font-size: .88rem;
        white-space: nowrap;
    }

    .stat-card.expired-card .stat-value {
        animation: pulseNum 1.6s ease-in-out infinite;
    }

    @@keyframes pulseNum {
        0%, 100% { text-shadow: 0 0 0 rgba(255,255,255,0); }
        50% { text-shadow: 0 0 14px rgba(255,255,255,.85); }
    }

    @@media (max-width: 700px) {
        .stats-row { flex-wrap: wrap; }
        .stat-card { min-width: 45%; }
    }

    /* ---------- چارت‌ها ---------- */
    .charts-row {
        display: flex;
        gap: 18px;
        margin-bottom: 30px;
        flex-wrap: wrap;
    }

    .chart-card {
        background: #fff;
        border-radius: 14px;
        padding: 18px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.08);
        flex: 1 1 320px;
    }

    .chart-card.chart-wide {
        flex-basis: 100%;
    }

    .chart-card h6 {
        margin: 0 0 12px;
        font-weight: 700;
        color: #333;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .chart-box {
        position: relative;
        height: 230px;
        width: 100%;
    }

    /* ---------- نوار فیلتر ---------- */
    .filter-bar {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: center;
        margin-bottom: 12px;
    }

    /* ---------- نوار پیشرفت زمان باقیمانده ---------- */
    .timer-wrap {
        display: flex;
        flex-direction: column;
        gap: 5px;
        min-width: 130px;
    }

    .timer-progress {
        display: block;
        height: 6px;
        background: #eee;
        border-radius: 4px;
        overflow: hidden;
    }

    .timer-progress-fill {
        display: block;
        height: 100%;
        width: 0%;
        background: linear-gradient(90deg,#20c997,#198754);
        transition: width .6s ease, background .6s ease;
    }

    /* ---------- درخشش کلیدهای منقضی ---------- */
    .expired-glow {
        animation: glow 1.4s ease-in-out infinite;
    }

    @@keyframes glow {
        0%, 100% { box-shadow: 0 0 0 rgba(220,53,69,0); }
        50% { box-shadow: 0 0 14px rgba(220,53,69,.55); }
    }

    /* ---------- عنوان بخش‌ها ---------- */
    .section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 700;
        margin: 24px 0 12px;
        font-size: 1.05rem;
    }

    /* ---------- فهرست آخرین فعالیت ---------- */
    .activity-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .activity-list li {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border-radius: 10px;
        background: #f8f9fa;
        margin-bottom: 8px;
        transition: background .2s ease;
    }

    .activity-list li:hover {
        background: #eef2f5;
    }

    .activity-list .activity-icon {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #198754;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: .9rem;
    }
</style>

<div class="dash-header">
    <h2 class="mb-0"><i class="fa-solid fa-gauge-high text-primary"></i> داشبورد مدیریت کلید</h2>
    <span class="text-muted small"><i class="fa-regular fa-clock"></i> آخرین بروزرسانی: @DateTime.Now.ToShamsiWithTime()</span>
</div>

<!-- آمار کلی: یک ردیف افقی -->
<div class="stats-row">
    <div class="stat-card">
        <i class="fa-solid fa-key stat-icon"></i>
        <p class="stat-value" data-count="@Model.TotalKeys">0</p>
        <p class="stat-label">کل کلیدها</p>
    </div>
    <div class="stat-card">
        <i class="fa-solid fa-circle-check stat-icon"></i>
        <p class="stat-value" data-count="@Model.AvailableKeys">0</p>
        <p class="stat-label">موجود</p>
    </div>
    <div class="stat-card">
        <i class="fa-solid fa-right-from-bracket stat-icon"></i>
        <p class="stat-value" data-count="@Model.CheckedOutKeys">0</p>
        <p class="stat-label">خارج‌شده</p>
    </div>
    <div class="stat-card expired-card">
        <i class="fa-solid fa-triangle-exclamation stat-icon"></i>
        <p class="stat-value" data-count="@Model.ExpiredKeys">0</p>
        <p class="stat-label">⚠ منقضی شده</p>
    </div>
</div>

<!-- چارت‌ها -->
<div class="charts-row">
    <div class="chart-card">
        <h6><i class="fa-solid fa-chart-pie text-primary"></i> وضعیت کلی کلیدها</h6>
        <div class="chart-box"><canvas id="statusChart"></canvas></div>
    </div>
    <div class="chart-card">
        <h6><i class="fa-solid fa-building text-warning"></i> کلیدهای خارج‌شده به تفکیک ساختمان</h6>
        <div class="chart-box"><canvas id="buildingChart"></canvas></div>
    </div>
    <div class="chart-card chart-wide">
        <h6><i class="fa-solid fa-chart-line text-success"></i> روند تحویل کلید (۷ روز اخیر)</h6>
        <div class="chart-box"><canvas id="trendChart"></canvas></div>
    </div>
</div>

<!-- کلیدهای منقضی شده -->
@if (Model.ExpiredHandovers.Any())
{
    <div class="expired-glow" style="border: 2px solid #dc3545; border-radius:12px; margin-bottom:30px; overflow:hidden;">
        <div style="background:#dc3545; color:white; padding:12px 20px;">
            <h5 style="margin:0;"><i class="fa-solid fa-triangle-exclamation"></i> کلیدهای منقضی شده (@Model.ExpiredHandovers.Count عدد)</h5>
            <small>این کلیدها از مهلت مقرر گذشته‌اند و باید بازگردانده شوند</small>
        </div>
        <table class="table table-bordered mb-0">
            <thead class="table-danger">
                <tr>
                    <th>کد کلید</th>
                    <th>اتاق</th>
                    <th>تحویل گیرنده</th>
                    <th>واحد</th>
                    <th>تحویل‌دهنده</th>
                    <th>زمان تحویل</th>
                    <th>مهلت بازگشت</th>
                    <th>تأخیر</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in Model.ExpiredHandovers)
                {
                    var delay = DateTime.Now - h.ExpiryTime!.Value;
                    <tr class="table-danger">
                        <td><strong>@h.Key.KeyCode</strong></td>
                        <td>@h.Key.RoomName — @h.Key.Building.Name</td>
                        <td>@h.ReceiverName</td>
                        <td>@h.ReceiverDepartment</td>
                        <td>@h.GuardName</td>
                        <td>@h.CheckoutTime.ToShamsiWithTime()</td>
                        <td>@h.ExpiryTime?.ToShamsiWithTime()</td>
                        <td>
                            <span class="badge bg-danger">
                                @((int)delay.TotalHours) ساعت و @(delay.Minutes) دقیقه تأخیر
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- کلیدهای فعال (منقضی نشده) -->
<div class="section-title"><i class="fa-solid fa-list-check text-warning"></i> کلیدهای فعلاً خارج‌شده (@Model.ActiveHandovers.Count عدد)</div>

@if (!Model.ActiveHandovers.Any())
{
    <div class="alert alert-info">هیچ کلید فعالی خارج نشده.</div>
}
else
{
    <div class="filter-bar">
        <div class="input-group input-group-sm" style="max-width:260px;">
            <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input id="searchBox" type="text" class="form-control" placeholder="جستجو کد کلید یا تحویل‌گیرنده..." />
        </div>
        <select id="buildingFilter" class="form-select form-select-sm" style="max-width:200px">
            <option value="">همه ساختمان‌ها</option>
            @foreach (var b in Model.BuildingNames)
            {
                <option value="@b">@b</option>
            }
        </select>
    </div>

    <table id="activeTable" class="table table-bordered mb-4">
        <thead class="table-warning">
            <tr>
                <th>کد کلید</th>
                <th>اتاق</th>
                <th>تحویل گیرنده</th>
                <th>واحد</th>
                <th>تحویل‌دهنده</th>
                <th>زمان تحویل</th>
                <th>مهلت تا</th>
                <th>زمان باقیمانده</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var h in Model.ActiveHandovers)
            {
                <tr data-keycode="@h.Key.KeyCode.ToLower()"
                    data-receiver="@h.ReceiverName.ToLower()"
                    data-building="@h.Key.Building.Name">
                    <td><strong>@h.Key.KeyCode</strong></td>
                    <td>@h.Key.RoomName — @h.Key.Building.Name</td>
                    <td>@h.ReceiverName</td>
                    <td>@h.ReceiverDepartment</td>
                    <td>@h.GuardName</td>
                    <td>@h.CheckoutTime.ToShamsiWithTime()</td>
                    <td>@h.ExpiryTime.ToShamsiWithTime()</td>
                    <td>
                        <span class="timer-wrap"
                              data-checkout="@(((DateTimeOffset)h.CheckoutTime).ToUnixTimeMilliseconds())"
                              data-expiry="@(((DateTimeOffset)h.ExpiryTime!.Value).ToUnixTimeMilliseconds())">
                            <span class="timer badge bg-warning text-dark">در حال محاسبه...</span>
                            <span class="timer-progress"><span class="timer-progress-fill"></span></span>
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- آخرین فعالیت -->
@if (Model.RecentHistory.Any())
{
    <div class="section-title"><i class="fa-solid fa-clock-rotate-left text-secondary"></i> آخرین کلیدهای بازگردانده‌شده</div>
    <ul class="activity-list">
        @foreach (var h in Model.RecentHistory)
        {
            <li>
                <span class="activity-icon"><i class="fa-solid fa-rotate-left"></i></span>
                <div>
                    <strong>@h.Key.KeyCode</strong> — @h.Key.RoomName (@h.Key.Building.Name)
                    <br />
                    <small class="text-muted">
                        تحویل‌گیرنده: @h.ReceiverName &nbsp;|&nbsp; بازگشت: @h.ReturnTime.ToShamsiWithTime()
                    </small>
                </div>
            </li>
        }
    </ul>
}

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script>
        // ---------- شمارش انیمیشنی کارت‌های آمار ----------
        document.querySelectorAll('.stat-value').forEach(function (el) {
            var target = parseInt(el.dataset.count, 10) || 0;
            var duration = 900;
            var start = null;
            function step(ts) {
                if (!start) start = ts;
                var progress = Math.min((ts - start) / duration, 1);
                var eased = 1 - Math.pow(1 - progress, 3);
                el.textContent = Math.round(eased * target);
                if (progress < 1) requestAnimationFrame(step);
                else el.textContent = target;
            }
            requestAnimationFrame(step);
        });

        // ---------- چارت‌ها ----------
        var statusData = @Html.Raw(Model.StatusChartJson);
        var buildingData = @Html.Raw(Model.BuildingChartJson);
        var trendData = @Html.Raw(Model.TrendChartJson);

        Chart.defaults.font.family = "'Segoe UI', Tahoma, sans-serif";
        Chart.defaults.maintainAspectRatio = false;
        Chart.defaults.responsive = true;

        new Chart(document.getElementById('statusChart'), {
            type: 'doughnut',
            data: {
                labels: statusData.labels,
                datasets: [{
                    data: statusData.values,
                    backgroundColor: ['#198754', '#fd7e14', '#dc3545'],
                    borderWidth: 0
                }]
            },
            options: {
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } },
                animation: { animateScale: true, animateRotate: true }
            }
        });

        new Chart(document.getElementById('buildingChart'), {
            type: 'bar',
            data: {
                labels: buildingData.labels,
                datasets: [{
                    label: 'تعداد کلید خارج‌شده',
                    data: buildingData.values,
                    backgroundColor: '#0d6efd',
                    borderRadius: 6
                }]
            },
            options: {
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });

        new Chart(document.getElementById('trendChart'), {
            type: 'line',
            data: {
                labels: trendData.labels,
                datasets: [{
                    label: 'تعداد تحویل',
                    data: trendData.values,
                    borderColor: '#20c997',
                    backgroundColor: 'rgba(32,201,151,0.15)',
                    fill: true,
                    tension: 0.35,
                    pointRadius: 4
                }]
            },
            options: {
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });

        // ---------- تایمر و نوار پیشرفت زمان باقیمانده ----------
        function updateTimers() {
            document.querySelectorAll('.timer-wrap').forEach(function (wrap) {
                var checkoutMs = parseInt(wrap.dataset.checkout, 10);
                var expiryMs = parseInt(wrap.dataset.expiry, 10);
                var now = Date.now();
                var total = expiryMs - checkoutMs;
                var elapsed = now - checkoutMs;
                var remaining = expiryMs - now;

                var badge = wrap.querySelector('.timer');
                var fill = wrap.querySelector('.timer-progress-fill');
                var percent = Math.min(100, Math.max(0, (elapsed / total) * 100));
                fill.style.width = percent + '%';

                if (remaining <= 0) {
                    badge.className = 'timer badge bg-danger';
                    badge.textContent = '⚠ منقضی شده';
                    fill.style.background = '#dc3545';
                    return;
                }

                var hours = Math.floor(remaining / 3600000);
                var minutes = Math.floor((remaining % 3600000) / 60000);
                var seconds = Math.floor((remaining % 60000) / 1000);

                badge.textContent = hours + ':' +
                    String(minutes).padStart(2, '0') + ':' +
                    String(seconds).padStart(2, '0') + ' مانده';

                if (remaining < 1800000) {
                    badge.className = 'timer badge bg-danger';
                    fill.style.background = 'linear-gradient(90deg,#fd7e14,#dc3545)';
                } else {
                    badge.className = 'timer badge bg-warning text-dark';
                    fill.style.background = 'linear-gradient(90deg,#20c997,#198754)';
                }
            });
        }
        updateTimers();
        setInterval(updateTimers, 1000);

        // ---------- جستجو و فیلتر جدول کلیدهای خارج‌شده ----------
        var searchBox = document.getElementById('searchBox');
        var buildingFilter = document.getElementById('buildingFilter');
        var activeTable = document.getElementById('activeTable');

        function applyFilter() {
            if (!activeTable) return;
            var term = (searchBox.value || '').trim().toLowerCase();
            var building = buildingFilter.value;
            activeTable.querySelectorAll('tbody tr').forEach(function (row) {
                var keycode = row.dataset.keycode || '';
                var receiver = row.dataset.receiver || '';
                var rowBuilding = row.dataset.building || '';
                var matchesTerm = !term || keycode.includes(term) || receiver.includes(term);
                var matchesBuilding = !building || rowBuilding === building;
                row.style.display = (matchesTerm && matchesBuilding) ? '' : 'none';
            });
        }

        if (searchBox) searchBox.addEventListener('input', applyFilter);
        if (buildingFilter) buildingFilter.addEventListener('change', applyFilter);
    </script>
}
