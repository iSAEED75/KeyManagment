@page
@model KeyManagment.Pages.Keys.DashboardModel
@{
    ViewData["Title"] = "داشبورد مدیر";
}

<h2>داشبورد مدیریت کلید</h2>

<!-- آمار کلی -->
<div style="display:grid; grid-template-columns:repeat(3,1fr); gap:15px; margin-bottom:30px;">
    <div style="background:#0d6efd; color:white; padding:20px; border-radius:8px; text-align:center;">
        <h3>@Model.TotalKeys</h3>
        <p>کل کلیدها</p>
    </div>
    <div style="background:#198754; color:white; padding:20px; border-radius:8px; text-align:center;">
        <h3>@Model.AvailableKeys</h3>
        <p>موجود</p>
    </div>
    <div style="background:#dc3545; color:white; padding:20px; border-radius:8px; text-align:center;">
        <h3>@Model.CheckedOutKeys</h3>
        <p>خارج‌شده</p>
    </div>
</div>

<!-- کلیدهای خارج‌شده -->
<h4>کلیدهای فعلاً خارج‌شده</h4>
<table class="table table-bordered">
    <thead class="table-danger">
        <tr>
            <th>کد کلید</th>
            <th>اتاق</th>
            <th>پیش چه کسی</th>
            <th>واحد</th>
            <th>تحویل‌دهنده</th>
            <th>از ساعت</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var h in Model.ActiveHandovers)
        {
            <tr>
                <td><strong>@h.Key.KeyCode</strong></td>
                <td>@h.Key.RoomName — @h.Key.Building.Name</td>
                <td>@h.ReceiverName</td>
                <td>@h.ReceiverDepartment</td>
                <td>@h.GuardName</td>
                <td>@h.CheckoutTime.ToString("HH:mm — yyyy/MM/dd")</td>
            </tr>
        }
    </tbody>
</table>

<!-- تاریخچه اخیر -->
<h4 class="mt-4">۲۰ تحویل اخیر بازگشت‌داده‌شده</h4>
<table class="table table-sm table-striped">
    <thead>
        <tr>
            <th>کد کلید</th>
            <th>تحویل‌گیرنده</th>
            <th>تحویل</th>
            <th>بازگشت</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var h in Model.RecentHistory)
        {
            <tr>
                <td>@h.Key.KeyCode</td>
                <td>@h.ReceiverName</td>
                <td>@h.CheckoutTime.ToString("HH:mm MM/dd")</td>
                <td>@h.ReturnTime?.ToString("HH:mm MM/dd")</td>
            </tr>
        }
    </tbody>
</table>