@page
@model KeyManagment.Pages.Admin.ManageUsersModel
@{
    ViewData["Title"] = "مدیریت کاربران";
}
<h2>مدیریت کاربران</h2>

@if (Model.SuccessMessage != null)
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}
@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
@if (Model.ImportErrors.Any())
{
    <div class="alert alert-warning">
        <strong>خطاهای import:</strong>
        <ul class="mb-0 mt-1">
            @foreach (var err in Model.ImportErrors)
            {
                <li>@err</li>
            }
        </ul>
    </div>
}

<!-- افزودن از اکسل -->
<div style="background:#e8f4fd; padding:20px; border-radius:8px; margin-bottom:20px; border:1px solid #b8daff;">
    <h5>📥 ورود اطلاعات از فایل اکسل</h5>
    <form method="post" enctype="multipart/form-data">
        <div style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap;">
            <div>
                <label class="form-label">انتخاب فایل اکسل</label>
                <input asp-for="ExcelFile" type="file" accept=".xlsx" class="form-control" />
            </div>
            <button type="submit" asp-page-handler="Import" class="btn btn-success">
                📤 وارد کردن کاربران
            </button>
            <button type="submit" asp-page-handler="DownloadTemplate" class="btn btn-outline-secondary">
                📋 دانلود فایل نمونه
            </button>
        </div>
        <small class="text-muted mt-1 d-block">
            ستون‌های فایل: شماره پرسنلی | نام کامل | شماره تماس | واحد | نقش | رمز عبور
        </small>
    </form>
</div>

<!-- افزودن تکی -->
<div style="background:#f8f9fa; padding:20px; border-radius:8px; margin-bottom:30px;">
    <h5>افزودن کاربر جدید</h5>
    <form method="post">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
            <div>
                <label class="form-label">نام کامل</label>
                <input asp-for="NewFullName" class="form-control" required />
            </div>
            <div>
                <label class="form-label">شماره پرسنلی</label>
                <input asp-for="NewPersonnelCode" class="form-control" placeholder="مثلاً: 12345" required />
            </div>
            <div>
                <label class="form-label">رمز عبور</label>
                <input asp-for="NewPassword" type="password" class="form-control" required />
            </div>
            <div>
                <label class="form-label">واحد</label>
                <input asp-for="NewDepartment" class="form-control" />
            </div>
            <div>
                <label class="form-label">شماره تماس</label>
                <input asp-for="NewPhone" class="form-control" placeholder="مثلاً: 09171234567" />
            </div>
            <div>
                <label class="form-label">نقش</label>
                <select asp-for="NewRole" class="form-control">
                    <option value="User">کارمند عادی</option>
                    <option value="Guard">حراست</option>
                    <option value="Admin">مدیر</option>
                </select>
            </div>
        </div>
        <button type="submit" asp-page-handler="Create" class="btn btn-primary mt-3">
            افزودن کاربر
        </button>
    </form>
</div>

<!-- لیست کاربران -->
<h5>لیست کاربران (@Model.Users.Count نفر)</h5>
<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>نام کامل</th>
            <th>شماره پرسنلی</th>
            <th>شماره تماس</th>
            <th>واحد</th>
            <th>نقش</th>
            <th>عملیات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Users)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@user.PersonnelCode</td>
                <td>@user.Phone</td>
                <td>@user.Department</td>
                <td>
                    @if (user.Role == "Admin")
                    {
                        <span class="badge bg-danger">مدیر</span>
                    }
                    else if (user.Role == "Guard")
                    {
                        <span class="badge bg-warning text-dark">حراست</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">کارمند</span>
                    }
                </td>
                <td>
                    <form method="post" style="display:inline;">
                        <input type="hidden" name="userId" value="@user.Id" />
                        <button type="submit"
                                asp-page-handler="Delete"
                                class="btn btn-sm btn-danger"
                                onclick="return confirm('کاربر @user.FullName حذف شود؟')">
                            حذف
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>